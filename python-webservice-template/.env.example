# Copy to .env and customise. .env is gitignored.

# ── Postgres ──────────────────────────────────────────────────────────────────
# DSN for asyncpg. docker-compose defaults: user/password/appdb on localhost:5432.
POSTGRES_URL=postgresql://user:password@localhost:5432/appdb

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ── Redis ──────────────────────────────────────────────────────────────────────
# REQUIRES the RedisJSON module (use redis-stack, e.g. redis/redis-stack-server).
# The cache uses JSON.SET/JSON.GET; stock Redis fails the startup probe fast.
REDIS_URL=redis://localhost:6379/0

# ── Ingest transport ───────────────────────────────────────────────────────────
# "solace" (default) or "noop" (no streaming; HTTP POST /data/ingest only)
INGEST_TRANSPORT=solace

# ── Solace PubSub+ (Guaranteed messaging) ─────────────────────────────────────
SOLACE_HOST=localhost
SOLACE_PORT=55555
SOLACE_VPN=default
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin
SOLACE_TOPIC=ingest/batches
# Durable exclusive queue, created on start. ONE PER REPLICA (per-instance cache).
SOLACE_QUEUE=python-template/ingest

# ── Server ─────────────────────────────────────────────────────────────────────
# Default: HTTPS on port 443 with certs/key.pem + certs/cert.pem.
# For plain HTTP during local dev override both:
# SERVER_PORT=8000
# Unset SSL_KEYFILE and SSL_CERTFILE (or point them at valid certs).
SERVER_HOST=0.0.0.0
SERVER_PORT=443
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem
