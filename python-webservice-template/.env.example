# Copy to .env and customise. .env is gitignored. Every name maps to a Settings
# field (settings.py), which lists the remaining options and their defaults.

# ── Postgres ──────────────────────────────────────────────────────────────────
# DSN for asyncpg. Same user/password/db as docker-compose.
POSTGRES_URL=postgresql://user:password@localhost:5432/appdb

# ── ClickHouse ─────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# ── Redis ──────────────────────────────────────────────────────────────────────
# REQUIRES the RedisJSON module (use redis-stack, e.g. redis/redis-stack-server).
# The cache uses JSON.SET/JSON.GET; stock Redis fails the startup probe fast.
REDIS_URL=redis://localhost:6379/0

# ── Ingest transport ───────────────────────────────────────────────────────────
# "noop" (default: HTTP POST /data/ingest only) or "solace" (stream from a queue)
INGEST_TRANSPORT=noop

# ── Solace PubSub+ (only read when INGEST_TRANSPORT=solace) ───────────────────
SOLACE_HOST=localhost
SOLACE_PORT=55555
SOLACE_VPN=default
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin
SOLACE_TOPIC=ingest/batches
# Durable exclusive queue, created on start. ONE PER REPLICA (per-instance cache).
SOLACE_QUEUE=python-template/ingest

# ── Server ─────────────────────────────────────────────────────────────────────
# Default: HTTPS on port 8443 with certs/key.pem + certs/cert.pem
# (generate them with `python certs/generate_self_signed_cert.py`).
# The container image also sets SERVER_PORT=8443; compose publishes it as 443.
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem

# ── /mcp Host allow-list: JSON array or comma-separated ───────────────────────
MCP_ALLOWED_HOSTS=localhost

# ── Logging and tracing ────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Set to an OTLP/HTTP endpoint (e.g. http://localhost:4318) to export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Authentication (off by default) ────────────────────────────────────────────
# AUTH_ENABLED=true
# AUTH_JWT_SECRET=change-me
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
