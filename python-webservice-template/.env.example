# Copy to .env and customise. .env is gitignored. Every name maps to a Settings
# field (settings.py). The names under "Shared" are part of the repo-wide env
# contract (pinned by tests/cicd/test_env_contract.py). Optional values and
# secrets are commented out.

# --- Shared ---

# App identity
APP_TITLE=Template Fast API Project
APP_VERSION=1.0.0
APP_DESCRIPTION=A Python FastAPI service with MCP endpoints, ready for Claude
CORRELATION_ID_HEADER=X-Request-ID

# Server. Default: HTTPS on port 8443 with certs/key.pem + certs/cert.pem
# (generate them with `python certs/generate_self_signed_cert.py`).
# The container image also sets SERVER_PORT=8443; compose publishes it as 443.
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem
MAX_REQUEST_BODY_BYTES=16777216
# Response compression: zstd preferred, gzip fallback, negotiated from
# Accept-Encoding. zstd/gzip request bodies are always accepted, and
# MAX_REQUEST_BODY_BYTES counts their decompressed size.
COMPRESSION_ENABLED=true
COMPRESSION_MIN_BYTES=1024
# 1-19. 3 is zstd's default speed/ratio balance.
COMPRESSION_ZSTD_LEVEL=3
# true: 406 unless Accept-Encoding allows zstd (probes, /metrics and /mcp exempt).
COMPRESSION_REQUIRE_ZSTD=false

# Logging, tracing and metrics
LOG_LEVEL=INFO
# Set to an OTLP/HTTP endpoint (e.g. http://localhost:4318) to export traces.
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=python-template
METRICS_ENABLED=true

# Authentication (off by default)
AUTH_ENABLED=false
# AUTH_JWT_SECRET=change-me
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=

# CORS (lists: JSON array or comma-separated)
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=false

# MCP (/mcp). Allowed Host headers: JSON array or comma-separated.
MCP_NAME=python-template
MCP_INSTRUCTIONS=Tools for this template application.
MCP_ALLOWED_HOSTS=localhost

# Health: per-dependency ping timeout, and how long probe results are reused (0 disables).
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
HEALTH_CACHE_TTL_SECONDS=5.0

# Startup retry (every store)
CONNECT_MAX_ATTEMPTS=5
CONNECT_BASE_DELAY=1.0
CONNECT_MAX_DELAY=30.0

# Postgres. DSN for asyncpg. Same user/password/db as docker-compose.
POSTGRES_URL=postgresql://user:password@localhost:5432/appdb
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_ACQUIRE_TIMEOUT_SECONDS=5.0

# Redis. REQUIRES the RedisJSON module (use redis-stack, e.g. redis/redis-stack-server).
# The cache uses JSON.SET/JSON.GET; stock Redis fails the startup probe fast.
REDIS_URL=redis://localhost:6379/0

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Ingest. "noop" (default: HTTP POST /data/ingest only) or "solace" (stream from a queue).
INGEST_TRANSPORT=noop
INGEST_MAX_DISCONNECT_SECONDS=60.0
INGEST_MAX_CONSECUTIVE_FAILURES=5
INGEST_RETRY_BASE_DELAY=1.0
INGEST_RETRY_MAX_DELAY=60.0
# Unset = staleness never reported.
# INGEST_STALENESS_THRESHOLD_SECONDS=
INGEST_STALE_FAILS_READINESS=false
MAX_INGEST_BATCH_BYTES=16777216

# LSM stream store (/data/cache)
LSM_FLUSH_ROWS=1000
LSM_COMPACTION_RUNS=4
LSM_KEY_COLUMNS=["id"]

# Solace PubSub+ (only read when INGEST_TRANSPORT=solace)
SOLACE_HOST=localhost
SOLACE_PORT=55555
SOLACE_VPN=default
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin
SOLACE_TOPIC=ingest/batches
# Durable exclusive queue, created on start. ONE PER REPLICA (per-instance cache).
SOLACE_QUEUE=python-template/ingest

# --- python only ---
STATUS=running
SHUTDOWN_TIMEOUT_SECONDS=30.0
POSTGRES_COMMAND_TIMEOUT_SECONDS=10.0
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=5.0
CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=30.0
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REDIS_CONNECT_TIMEOUT_SECONDS=5.0
REDIS_MAX_CONNECTIONS=50
INGEST_JOIN_TIMEOUT_SECONDS=10.0
