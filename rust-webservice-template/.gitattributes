# Files executed or parsed inside Linux containers (the image build runs
# certs/generate_self_signed_cert.sh; R2/R3 mount init scripts into stores).
# CRLF breaks the shebang ("/bin/bash^M: bad interpreter"), so force LF
# regardless of the developer's core.autocrlf.
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
docker-compose*.yml text eol=lf
.env.example text eol=lf
# Arrow IPC test data.
*.ipc binary
