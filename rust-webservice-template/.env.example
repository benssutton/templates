# Copy to .env and customise. .env is gitignored. Names match the Python
# template's settings; lists accept JSON (["a","b"]) or comma-separated.

# ── Server ────────────────────────────────────────────────────────────────────
# Default: HTTPS on 443 with ./certs/key.pem + ./certs/cert.pem
# (mint them with certs/generate_self_signed_cert.sh).
# Plain HTTP for local dev: SERVER_PORT=8000 and set SSL_CERTFILE= / SSL_KEYFILE= (empty).
SERVER_HOST=0.0.0.0
SERVER_PORT=443
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem
STATUS=running

# ── Stores (names and defaults match the Python template) ─────────────────────
# docker-compose.yml does not publish the store ports. To run the binary on the
# host against the compose stores, add `ports:` to the store services locally.
POSTGRES_URL=postgresql://appuser:password@localhost:5432/appdb
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Redis must have the RedisJSON module (redis-stack); startup fails otherwise.
REDIS_URL=redis://localhost:6379/0

# ── Ingest transport (used from R3) ───────────────────────────────────────────
# solace (default) | noop
INGEST_TRANSPORT=noop

# ── Startup retry (every store) ───────────────────────────────────────────────
CONNECT_MAX_ATTEMPTS=5
CONNECT_BASE_DELAY=1.0
CONNECT_MAX_DELAY=30.0

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
CORRELATION_ID_HEADER=X-Request-ID

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_REQUEST_BODY_BYTES=16777216

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=false

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info
