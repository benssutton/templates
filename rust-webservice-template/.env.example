# Copy to .env and customise. .env is gitignored. Every name maps to a Settings
# field (src/settings.rs). The names under "Shared" are the same in the Python and
# Java templates (pinned by tests/cicd/test_env_contract.py). Lists accept JSON
# (["a","b"]) or comma-separated.

# --- Shared ---

# App identity
APP_TITLE=Rust Template Service
APP_VERSION=1.0.0
APP_DESCRIPTION=A Rust axum service with REST and MCP endpoints, ready for Claude
# Inbound ids are kept only if 1-128 chars of [A-Za-z0-9._-].
CORRELATION_ID_HEADER=X-Request-ID

# Server. Default: HTTPS on 8443 with ./certs/key.pem + ./certs/cert.pem
# (mint them with certs/generate_self_signed_cert.sh).
# Plain HTTP for local dev: set SSL_CERTFILE= / SSL_KEYFILE= (empty).
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SSL_KEYFILE=./certs/key.pem
SSL_CERTFILE=./certs/cert.pem
MAX_REQUEST_BODY_BYTES=16777216

# Logging, tracing and metrics.
# LOG_LEVEL is an EnvFilter directive, e.g. info or info,rust_template=debug.
LOG_LEVEL=info
# OTLP/HTTP collector base URL; empty = no trace export. Inbound W3C
# traceparent headers continue the caller's trace.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rust-template
METRICS_ENABLED=true

# Authentication (off by default). When on, every route but /health/live and
# /health/ready needs `Authorization: Bearer <HS256 JWT>`. Startup fails if
# enabled with no secret.
AUTH_ENABLED=false
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

# CORS
CORS_ALLOW_ORIGINS=["*"]
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_ALLOW_CREDENTIALS=false

# MCP (/mcp)
MCP_NAME=rust-template
MCP_INSTRUCTIONS=Tools for this template application.
# Host headers /mcp accepts, and the http(s) Origins on those hosts
# (DNS-rebinding protection; 403 otherwise). An entry without a port matches
# any port. Must not be empty. Compose uses localhost,127.0.0.1,app.
MCP_ALLOWED_HOSTS=localhost

# Health: per-dependency ping timeout, and how long probe results are reused
# by /health and /metrics (0 probes every call).
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
HEALTH_CACHE_TTL_SECONDS=2.0

# Startup retry (every store)
CONNECT_MAX_ATTEMPTS=5
CONNECT_BASE_DELAY=1.0
CONNECT_MAX_DELAY=30.0

# Stores. docker-compose.yml does not publish the store ports. To run the binary
# on the host against the compose stores, add `ports:` to the store services locally.
POSTGRES_URL=postgresql://appuser:password@localhost:5432/appdb
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_ACQUIRE_TIMEOUT_SECONDS=5
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# Redis must have the RedisJSON module (redis-stack); startup fails otherwise.
REDIS_URL=redis://localhost:6379/0

# Ingest
# noop (default) | solace (needs a build with `--features solace`)
INGEST_TRANSPORT=noop
# Not CONNECTED for longer than this -> shutdown; empty disables it.
INGEST_MAX_DISCONNECT_SECONDS=60
# Consecutive transport failures -> shutdown; 0 disables it.
INGEST_MAX_CONSECUTIVE_FAILURES=5
# Transport retry wait: first value, doubled per failure up to the cap (seconds;
# the cap must not be below the first value).
INGEST_RETRY_BASE_DELAY=1.0
INGEST_RETRY_MAX_DELAY=60.0
# Empty = staleness never reported.
INGEST_STALENESS_THRESHOLD_SECONDS=
INGEST_STALE_FAILS_READINESS=false
# A decoded batch over this is 413 over HTTP and rejected on the stream.
MAX_INGEST_BATCH_BYTES=16777216

# LSM stream store (/data/cache)
LSM_FLUSH_ROWS=1000
LSM_COMPACTION_RUNS=4
LSM_KEY_COLUMNS=["id"]

# Solace (AMQP 1.0; the VPN is chosen by the AMQP port)
SOLACE_HOST=localhost
SOLACE_PORT=5672
SOLACE_VPN=default
# Empty = SASL ANONYMOUS (an auth-`none` VPN offers nothing else over AMQP);
# set both to use SASL PLAIN.
SOLACE_USERNAME=
SOLACE_PASSWORD=
SOLACE_TOPIC=ingest/batches
# Durable exclusive queue this instance binds. ONE QUEUE PER REPLICA: the LSM
# store is a per-instance cache, and an exclusive queue feeds one consumer.
SOLACE_QUEUE=rust-template/ingest

# --- rust only ---
STATUS=running
# json | text.
LOG_FORMAT=json

# A request with no response after this is answered 503.
REQUEST_TIMEOUT_SECONDS=30
# Requests in flight app-wide, and POST /data/ingest requests in flight;
# beyond either, new requests are shed with 503.
MAX_CONCURRENT_REQUESTS=1024
INGEST_MAX_IN_FLIGHT=4

POSTGRES_STATEMENT_TIMEOUT_SECONDS=10
CLICKHOUSE_QUERY_TIMEOUT_SECONDS=10
REDIS_CONNECTION_TIMEOUT_SECONDS=2
REDIS_RESPONSE_TIMEOUT_SECONDS=5

# Memory bound: over it the LSM store compacts, then evicts the oldest rows.
LSM_MAX_ROWS=1000000

# The queue and its subscription are provisioned via SEMP v2 at startup.
SOLACE_SEMP_URL=http://localhost:8080
# Default-dev credentials only: change for anything beyond a local stack.
SOLACE_SEMP_USERNAME=admin
SOLACE_SEMP_PASSWORD=admin
