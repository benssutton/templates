# Copy to .env and customise (export the variables, or pass them to the container).
# Every name is read by application.yml or by EnvContract.java. The names under
# "Shared" are the same in the Python and Rust templates (pinned by
# tests/cicd/test_env_contract.py). Optional values and secrets are commented out.
#
# SSL_CERTFILE and SSL_KEYFILE are not used: Micronaut serves TLS from a PKCS12
# keystore (application-docker.yml, KEYSTORE_PASSWORD below).

# --- Shared ---

# App identity
APP_TITLE=Template Micronaut Service
APP_VERSION=1.0.0
APP_DESCRIPTION=A Java Micronaut service template
CORRELATION_ID_HEADER=X-Request-ID

# Server. HTTPS on 8443 in the container (docker profile); plain HTTP otherwise.
# SERVER_HOST is optional: unset binds every interface.
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
MAX_REQUEST_BODY_BYTES=16777216

# Logging, tracing and metrics. METRICS_ENABLED=false removes /metrics (404).
LOG_LEVEL=INFO
# OTLP endpoint for traces; used only when OTEL_TRACES_EXPORTER=otlp.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=java-template
METRICS_ENABLED=true

# Authentication (off by default)
AUTH_ENABLED=false
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=

# CORS (comma-separated lists)
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# MCP (/mcp). Allowed Host headers: JSON array or comma-separated.
MCP_NAME=java-template
MCP_INSTRUCTIONS=Tools for this template application. Each tool mirrors a read-only REST endpoint.
MCP_ALLOWED_HOSTS=localhost

# Health: per-dependency ping timeout, and how long probe results are reused (0 disables).
HEALTH_CHECK_TIMEOUT_SECONDS=2.0
HEALTH_CACHE_TTL_SECONDS=5

# Startup retry (every store)
CONNECT_MAX_ATTEMPTS=5
CONNECT_BASE_DELAY=1.0
CONNECT_MAX_DELAY=30.0

# Postgres. EnvContract turns the URL into a JDBC URL plus username/password.
POSTGRES_URL=postgresql://appuser:password@localhost:5432/appdb
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
# Seconds; EnvContract converts to the pool's millisecond timeout (default 3s).
# POSTGRES_ACQUIRE_TIMEOUT_SECONDS=3

# Redis. Needs the RedisJSON module (redis-stack).
REDIS_URL=redis://localhost:6379/0

# ClickHouse. EnvContract builds jdbc:ch://HOST:PORT/DATABASE.
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

# Ingest. noop (HTTP ingest only) | solace.
INGEST_TRANSPORT=noop
INGEST_MAX_DISCONNECT_SECONDS=60
INGEST_MAX_CONSECUTIVE_FAILURES=5
INGEST_RETRY_BASE_DELAY=1.0
INGEST_RETRY_MAX_DELAY=60.0
INGEST_STALENESS_THRESHOLD_SECONDS=0
INGEST_STALE_FAILS_READINESS=false
MAX_INGEST_BATCH_BYTES=16777216

# LSM stream store (/data/cache). The Java store supports the key column "id" only.
LSM_FLUSH_ROWS=1000
LSM_COMPACTION_RUNS=4
LSM_KEY_COLUMNS=id

# Solace PubSub+ (only used when INGEST_TRANSPORT=solace)
SOLACE_HOST=localhost
SOLACE_PORT=55555
SOLACE_VPN=default
SOLACE_USERNAME=admin
SOLACE_PASSWORD=admin
SOLACE_TOPIC=ingest/batches
# Durable exclusive queue. ONE PER REPLICA (per-instance cache).
SOLACE_QUEUE=java-template/ingest

# --- java only ---
# Password of the PKCS12 keystore the docker profile serves TLS from.
KEYSTORE_PASSWORD=changeit
SHUTDOWN_GRACE_PERIOD=20s
REDIS_POOL_SIZE=16
CLICKHOUSE_POOL_SIZE=10
# none | otlp
OTEL_TRACES_EXPORTER=none
# Retention cap for the LSM store: the oldest live rows are evicted over it.
LSM_MAX_ROWS=1000000
